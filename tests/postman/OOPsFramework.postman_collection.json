				{
					"name": "2. GET Function by ID (Valid)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Создаем пользователя для теста функций",
									"const timestamp = Date.now();",
									"const createUserRequest = {",
									"    url: pm.variables.get('baseUrl') + '/api/users',",
									"    method: 'POST',",
									"    header: {",
									"        'Content-Type': 'application/json'",
									"    },",
									"    body: {",
									"        mode: 'raw',",
									"        raw: JSON.stringify({",
									"            login: 'funcuser_' + timestamp,",
									"            password: 'funcpass'",
									"        })",
									"    }",
									"};",
									"",
									"pm.sendRequest(createUserRequest, function(err, res) {",
									"    if (!err) {",
									"        const userId = res.json().id;",
									"        pm.variables.set('funcUserId', userId);",
									"        ",
									"        // Создаем табулированную функцию",
									"        const createFuncRequest = {",
									"            url: pm.variables.get('baseUrl') + '/api/tabulated-functions',",
									"            method: 'POST',",
									"            header: {",
									"                'Content-Type': 'application/json'",
									"            },",
									"            body: {",
									"                mode: 'raw',",
									"                raw: JSON.stringify({",
									"                    name: 'Test Function',",
									"                    data: [1, 2, 3, 4, 5],",
									"                    derivative: [0, 1, 0, 1, 0],",
									"                    userId: userId",
									"                })",
									"            }",
									"        };",
									"        ",
									"        pm.sendRequest(createFuncRequest, function(err2, res2) {",
									"            if (!err2) {",
									"                pm.variables.set('tabFuncId', res2.json().id);",
									"            }",
									"        });",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has function data\", function() {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(jsonData.name).to.eql('Test Function');",
									"    pm.expect(jsonData.userId).to.be.a('number');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/tabulated-functions/{{tabFuncId}}",
							"host": [
